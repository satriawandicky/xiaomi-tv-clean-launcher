<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens a photo wallpaper so the clock, cards and dock stay readable: lighter in the middle, darker at
     the top bar and at the dock. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#B3000000" android:centerColor="#59000000" android:endColor="#E6000000" />
</shape>
