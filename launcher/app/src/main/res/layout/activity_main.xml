<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="@font/outfit_light"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- The header texts use gravity left, not start: the launcher lays out left to right
                     (no supportsRtl), and with start a right-to-left script such as Arabic would move to the
                     right edge of these full-width lines instead of staying under the clock. -->
                <TextView
                    android:id="@+id/greeting"
                    android:gravity="left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="52sp"
                        android:fontFamily="@font/outfit_light"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:orientation="vertical">

                        <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                        <TextView
                            android:id="@+id/shamsiDate"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#E6FFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="@font/outfit_regular"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false"
                            android:visibility="gone" />

                        <TextClock
                            android:id="@+id/date"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="@bool/date_single_line"
                            android:maxLines="2"
                            android:lineSpacingExtra="6dp"
                            android:ellipsize="end"
                            android:format12Hour="@string/date_format_home"
                            android:format24Hour="@string/date_format_home"
                            android:textColor="#A6FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Shown only when show_stats is on. Gone, it takes no space, so the clock stays put. -->
                <TextView
                    android:id="@+id/stats"
                    android:gravity="left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#D9FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.04"
                    android:focusable="false"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Today's prayer times (InfoPanel), the next one in full white with a countdown. -->
        <TextView
            android:id="@+id/prayer"
            android:gravity="left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#8CFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:focusable="false"
            android:visibility="gone" />

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- Info cards between the header and the dock (InfoPanel): a slim 7-day weather strip, then the Premier
         League table and a rotating news highlight side by side. Never focusable, so D-pad paths stay as they
         were; faded out while the grid is scrolled down. -->
    <LinearLayout
        android:id="@+id/infoCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="126dp"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:orientation="vertical"
        android:focusable="false">

        <LinearLayout
            android:id="@+id/weatherCard"
            style="@style/InfoCard"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/weatherTitle"
                style="@style/InfoCardTitle"
                android:layout_width="wrap_content"
                android:layout_marginEnd="12dp" />
            <LinearLayout
                android:id="@+id/weatherDays"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/teamCard"
                style="@style/InfoCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:visibility="gone">
                <TextView android:id="@+id/teamTitle" style="@style/InfoCardTitle" />
                <LinearLayout
                    android:id="@+id/leagueTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="vertical" />
                <TextView android:id="@+id/teamNext" style="@style/InfoCardLine" android:layout_marginTop="5dp" android:textColor="#E6FFFFFF" />
                <TextView android:id="@+id/teamLast" style="@style/InfoCardLine" android:layout_marginTop="1dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/newsCard"
                style="@style/InfoCard"
                android:layout_width="0dp"
                android:layout_weight="1.15"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/newsChip"
                        style="@style/InfoCardTitle"
                        android:layout_width="wrap_content"
                        android:background="@drawable/news_chip"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textColor="#FFFFFFFF" />
                    <TextView
                        android:id="@+id/newsCount"
                        style="@style/InfoCardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end" />
                </LinearLayout>
                <!-- The headline slides up and fades into the next one every few seconds. -->
                <TextView
                    android:id="@+id/newsHeadline"
                    style="@style/InfoCardMain"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:singleLine="false"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="13sp"
                    android:autoSizeMaxTextSize="19sp"
                    android:textSize="19sp" />
                <!-- When the headlines are fetched again. -->
                <TextView
                    android:id="@+id/newsUpdate"
                    style="@style/InfoCardTitle"
                    android:layout_marginTop="4dp"
                    android:textSize="9sp" />
                <!-- Time left on this headline: a thin bar that fills up, then the next headline comes in. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#26FFFFFF">
                    <View
                        android:id="@+id/newsProgress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#CCFFFFFF"
                        android:transformPivotX="0dp"
                        android:scaleX="0" />
                </FrameLayout>
            </LinearLayout>

            <!-- Quote of the moment (Quotes.java): Qur'an, hadis, Indonesian or English, crossfading every few minutes. -->
            <LinearLayout
                android:id="@+id/quoteCard"
                style="@style/InfoCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/quoteChip"
                        style="@style/InfoCardTitle"
                        android:layout_width="wrap_content"
                        android:background="@drawable/news_chip"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textColor="#FFFFFFFF" />
                    <!-- When the next quote comes. -->
                    <TextView
                        android:id="@+id/quoteNext"
                        style="@style/InfoCardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/quoteBody"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/quoteText"
                        style="@style/InfoCardMain"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:singleLine="false"
                        android:maxLines="6"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp"
                        android:fontFamily="@font/outfit_light"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="11sp"
                        android:autoSizeMaxTextSize="17sp"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/quoteSource"
                        style="@style/InfoCardLine"
                        android:layout_marginTop="6dp"
                        android:textColor="#B3FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Where the wallpaper photo was taken ("Place, Region, Country"), bottom right under the dock. -->
    <TextView
        android:id="@+id/wallCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="20dp"
        android:maxWidth="520dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit_regular"
        android:letterSpacing="0.04"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:focusable="false" />

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
